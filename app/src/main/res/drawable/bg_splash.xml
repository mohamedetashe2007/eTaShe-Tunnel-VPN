<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#3A0509"
                android:centerColor="#1A0304"
                android:endColor="#0A0A0C" />
        </shape>
    </item>
    <item android:gravity="center" android:width="160dp" android:height="160dp">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
</layer-list>
